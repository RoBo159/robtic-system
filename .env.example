# Robtic — environment.
#
# Copy to .env and fill in. Everything the code actually reads is listed here; anything not listed
# is not read by anything, whatever an older .env may still contain.
#
# On the server this file lives at /home/robtic/robtic-system/.env and is shared by every container
# (see infra/docker/compose/docker-compose.yml env_file).

# ─── Required ────────────────────────────────────────────────────────────────────────────────────

# development or production. This decides which bot token is read — see below — so it is not
# cosmetic. Set it deliberately.
NODE_ENV=production

MONGODB_URI=mongodb://user:password@host:27017/robtic


# ─── Bot token ───────────────────────────────────────────────────────────────────────────────────
#
# NODE_ENV picks the variable: production reads MainBotToken, anything else reads TestBot.
# Set the one matching your NODE_ENV. Setting only the other is the single most common cause of
# "the bot is running but nothing works".
#
# The platform API and the dashboard API read the SAME variable, by the same rule — there is no
# separate bot token to configure for either of them. The platform API uses it to check Discord
# roles live, post moderation log embeds, and apply /staff promote|demote; the dashboard API uses it
# to read a guild's roles and channels for the settings pickers. Without it those fail silently (or,
# for the dashboard API, refuse to start).
MainBotToken=
TestBot=

# The staff/home server. Punishments and appeals resolve against this guild, so it is not the same
# thing as the server whitelist below.
MainGuild=

# Your Discord user id. This is the one identity that bypasses every permission check, including
# admin-scoped commands, so treat it like a credential. Leave it blank and nobody gets that bypass —
# the super-user whitelist (/whitelist), server operators and staff tiers still work normally.
BOT_OWNER_ID=

# Optional. When set, slash commands register to this one guild instead of globally — guild
# registration is instant, global takes up to an hour. Use it while developing, leave it blank in
# production or your commands will only exist in that guild.
COMMAND_GUILD_ID=


# ─── Server whitelist ────────────────────────────────────────────────────────────────────────────
#
# Not an environment variable. Which servers the bot may stay in is stored in MongoDB and managed
# in Discord with `!addserver <serverid>` / `!removeserver <serverid>`. The permanent Robtic
# servers are seeded into a fresh database automatically (libs/constants/src/allowed-guilds.ts).
#
# The bot leaves any server not on that list, so add a server before inviting it.


# ─── Robtic API ──────────────────────────────────────────────────────────────────────────────────

# Port the platform API listens on. Default 3002.
ROBTIC_API_PORT=3002

# Bind address. Leave as 0.0.0.0 — inside a container, loopback is unreachable from the published
# port and every request is refused before it reaches the process.
ROBTIC_API_HOST=0.0.0.0

# Public base URL, shown in the generated OpenAPI document.
ROBTIC_API_PUBLIC_URL=https://api.robtic.org





# ─── Cosmetic ────────────────────────────────────────────────────────────────────────────────────
# Shown by !ip and !status. Both optional; omitted from the embed when blank.

ROBTIC_WEBSITE_URL=
ROBTIC_DISCORD_INVITE=


# ─── Dashboard stack ─────────────────────────────────────────────────────────────────────────────
# Required by robtic-dashboard-api. It refuses to start without them and names the ones it is
# missing, so an absent variable here is a container that exits at boot — which Compose reports only
# as "dependency failed to start: container robtic-system-robtic-dashboard-api-1 is unhealthy".
#
# Read them out of the container with:
#   docker compose -f infra/docker/compose/docker-compose.yml -p robtic-system logs robtic-dashboard-api

# The Discord OAuth application. Add <DASHBOARD_API_URL>/auth/callback to its redirect URIs.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Bot token: MainBotToken / TestBot above, not a separate variable — the bot the dashboard reads
# guild roles and channels through must be the same one actually in the guilds being administered.

# Signs session cookies. Any long random string — `openssl rand -hex 32`. Rotating it signs
# everybody out, which is the intended emergency stop.
DASHBOARD_SESSION_SECRET=

# Where the browser reaches the API and the web app. Both need the scheme; the OAuth redirect is
# built from DASHBOARD_API_URL by concatenation, so a bare hostname produces a URL Discord rejects.
# Defaults are the local ports, which is what a developer stack wants.
DASHBOARD_API_URL=http://localhost:3003
DASHBOARD_URL=http://localhost:3000

# What the web app tells the *browser* to call. Read at request time, never baked into the image.
DASHBOARD_PUBLIC_API_URL=http://localhost:3003

# Optional. Defaults to true when DASHBOARD_API_URL is https, false otherwise — which is almost
# always what you want. Set it to false explicitly only for http development.
# Accepts true/false/1/0/yes/no/on/off.
DASHBOARD_SECURE_COOKIES=

# Optional. Defaults to 3003 and to seven days in milliseconds.
DASHBOARD_API_PORT=
DASHBOARD_SESSION_TTL_MS=


# ─── Minecraft test stack (compose/docker-compose.local.yml only) ────────────────────────────────
# Read by Compose, never by application code. Not needed in production.

# Set TRUE to accept Mojang's EULA and let the local Paper container start.
MINECRAFT_EULA=FALSE
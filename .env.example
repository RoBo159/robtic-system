# Robtic — environment.
#
# Copy to .env and fill in. Everything the code actually reads is listed here; anything not listed
# is not read by anything, whatever an older .env may still contain.
#
# On the server this file lives at /home/robtic/robtic-system/.env and is shared by every container
# (see docker-compose.yml env_file).

# ─── Required ────────────────────────────────────────────────────────────────────────────────────

# development or production. This decides which bot token is read — see below — so it is not
# cosmetic. Set it deliberately.
NODE_ENV=production

MONGODB_URI=mongodb://user:password@host:27017/robtic


# ─── Bot token ───────────────────────────────────────────────────────────────────────────────────
#
# NODE_ENV picks the variable: production reads MainBotToken, anything else reads TestBot.
# Set the one matching your NODE_ENV. Setting only the other is the single most common cause of
# "the bot is running but nothing works".
#
# The API reads the SAME variable, by the same rule, and uses it to check Discord roles live, post
# moderation log embeds, and apply /staff promote|demote. Without it those three fail silently and
# staff ranks fall back to a stored projection.
MainBotToken=
TestBot=

# The staff/home server. Punishments and appeals resolve against this guild, so it is not the same
# thing as the server whitelist below.
MainGuild=

# Your Discord user id. This is the one identity that bypasses every permission check, including
# admin-scoped commands, so treat it like a credential. Leave it blank and nobody gets that bypass —
# the super-user whitelist (/whitelist), server operators and staff tiers still work normally.
BOT_OWNER_ID=

# Optional. When set, slash commands register to this one guild instead of globally — guild
# registration is instant, global takes up to an hour. Use it while developing, leave it blank in
# production or your commands will only exist in that guild.
COMMAND_GUILD_ID=


# ─── Server whitelist ────────────────────────────────────────────────────────────────────────────
#
# Not an environment variable. Which servers the bot may stay in is stored in MongoDB and managed
# in Discord with `!addserver <serverid>` / `!removeserver <serverid>`. The permanent Robtic
# servers are seeded into a fresh database automatically (libs/constants/src/allowed-guilds.ts).
#
# The bot leaves any server not on that list, so add a server before inviting it.


# ─── Robtic API ──────────────────────────────────────────────────────────────────────────────────

# Port the platform API listens on. Default 3002.
ROBTIC_API_PORT=3002

# Bind address. Leave as 0.0.0.0 — inside a container, loopback is unreachable from the published
# port and every request is refused before it reaches the process.
ROBTIC_API_HOST=0.0.0.0

# Public base URL, shown in the generated OpenAPI document.
ROBTIC_API_PUBLIC_URL=https://api.robtic.org

# Port for the separate legacy API (apps/api). Not the platform API above.
API_PORT=3001


# ─── Discord OAuth ───────────────────────────────────────────────────────────────────────────────
# Used by the activity app. VITE_DISCORD_CLIENT_ID is baked in at build time, not read at runtime.

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
VITE_DISCORD_CLIENT_ID=


# ─── Cosmetic ────────────────────────────────────────────────────────────────────────────────────
# Shown by !ip and !status. Both optional; omitted from the embed when blank.

ROBTIC_WEBSITE_URL=
ROBTIC_DISCORD_INVITE=


# ─── Minecraft test stack (docker-compose.local.yml only) ────────────────────────────────────────
# Read by Compose, never by application code. Not needed in production.

# Set TRUE to accept Mojang's EULA and let the local Paper container start.
MINECRAFT_EULA=FALSE
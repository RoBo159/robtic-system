TestBot=
MainBotToken=
CommunityBotToken=
ModerationBotToken=
ModeMailBotToken=
HRBotToken=
DevBotToken=

STATUS_WEBHOOK=
MONGODB_URI=mongodb://localhost:27017/robtic

TestGuild=
MainGuild=

NODE_ENV=development

# =============================
# GROQ AI CONFIG
# =============================

GROQ_API_KEY=

AI_MODEL=

AI_TIMEOUT_MS=

AI_ENABLED=


# =============================
# OPTIONAL FALLBACK SETTINGS
# =============================

AI_MIN_MESSAGE_LENGTH=
AI_SUPPORT_CHANNEL_ONLY=


# =============================
# DISCORD ACTIVITY / EMBEDDED APP SDK
# =============================

# From the Discord Developer Portal -> your application -> OAuth2.
# VITE_DISCORD_CLIENT_ID is exposed to the browser (public); it is the same
# application id as DISCORD_CLIENT_ID, duplicated because only VITE_-prefixed
# vars reach the Vite client.
VITE_DISCORD_CLIENT_ID=

# Used by apps/api for the OAuth2 code -> access token exchange.
DISCORD_CLIENT_ID=
# NEVER expose this to the client. Portal -> OAuth2 -> Client Secret.
DISCORD_CLIENT_SECRET=

# Port for apps/api (token exchange + future REST/WS). The activity dev server
# proxies /.proxy/* to this port locally.
API_PORT=3001


# =============================
# LOCAL MINECRAFT TEST STACK
# =============================
# Only read by docker-compose.local.yml. Not used in production.

# Set to TRUE to accept the Minecraft EULA (https://aka.ms/MinecraftEULA).
# The Paper container refuses to start until you do.
MINECRAFT_EULA=TRUE

# Discord guild the test server links against. The plugin disables itself when unset.
MINECRAFT_GUILD_ID=

# Identity of the test server in the Discord status panel.
MINECRAFT_SERVER_KEY=local
MINECRAFT_SERVER_NAME=Local Test Server
# --- Slash command registration -------------------------------------------------------------
# Guild to publish slash commands to. When set, commands appear IMMEDIATELY in that server.
#
# Leave it empty and commands register globally, which Discord caches for up to an hour — a new
# command then looks broken for that whole window, and neither restarting the bot nor kicking and
# re-inviting it makes any difference. Set this to your main guild id unless the bot is public.
COMMAND_GUILD_ID=

# --- Robtic API ------------------------------------------------------------------------------
# Port the platform API listens on. It owns MongoDB; the bot and Minecraft servers are its clients.
ROBTIC_API_PORT=3002
# Public URL, used in the generated OpenAPI document.
ROBTIC_API_PUBLIC_URL=https://api.robtic.org

# Shown as buttons under !ip and !status. Optional.
ROBTIC_WEBSITE_URL=
ROBTIC_DISCORD_INVITE=

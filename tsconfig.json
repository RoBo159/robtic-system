{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "types": ["bun"],

    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "ignoreDeprecations": "6.0",

    "strict": true,
    "skipLibCheck": true,

    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@bot/*": ["apps/bot/src/*"],
      "@database/*": ["libs/database/src/*"],
      "@core/*": ["libs/core/src/*"],
      "@types/*": ["libs/types/src/*"],
      "@typings/*": ["libs/types/src/*"],
      "@config": ["libs/config/src/index.ts"],
      "@config/*": ["libs/config/src/*"],
      "@constants": ["libs/constants/src/index.ts"],
      "@constants/*": ["libs/constants/src/*"],
      "@utils": ["libs/utils/src/index.ts"],
      "@utils/*": ["libs/utils/src/*"],
      "@logger": ["libs/logger/src/index.ts"],
      "@logger/*": ["libs/logger/src/*"],
      "@sdk": ["libs/sdk/src/api.ts"],
      "@sdk/*": ["libs/sdk/src/*"]
    }
  },
  "include": ["apps", "libs", "scripts"],
  // The two web apps compile themselves. Nest needs `emitDecoratorMetadata` for its DI and Next
  // needs `jsx`; turning either on here would change how the bot and the plugin API compile, so
  // each carries its own tsconfig and its own `typecheck` script.
  "exclude": ["node_modules", "dist", "apps/dashboard", "apps/dashboard-api"]
}

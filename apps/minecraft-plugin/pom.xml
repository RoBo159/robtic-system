<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.robtic</groupId>
    <artifactId>robtic-minecraft</artifactId>
    <version>3.3.2</version>
    <packaging>jar</packaging>

    <name>RobticMinecraft</name>
    <description>Minecraft client for the Robtic platform - staff management, account linking, shared coin economy, ore exchange, chat bridge, and LuckPerms sync, all over the Robtic API.</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!--
          1.21.7 is the floor for the Dialog API, which is RobticAuth's primary login surface on
          Java. Minecraft added dialogs in 1.21.6 and Paper exposed them in 1.21.7, so this is the
          oldest version that can build the login screen at all — and it raises the minimum server
          version to match, deliberately.
        -->
        <paper.version>1.21.7-R0.1-SNAPSHOT</paper.version>
        <luckperms.version>5.4</luckperms.version>
        <gson.version>2.11.0</gson.version>
        <placeholderapi.version>2.11.6</placeholderapi.version>
        <floodgate.version>2.2.3-SNAPSHOT</floodgate.version>
        <!--
          Citizens is supported and not required. Compile-only: CitizensNpcProvider is the sole place
          its types appear, so a server without it never resolves them. FancyNPCs is supported too
          and needs no version here — see the dependency block for why it is reached by reflection.
        -->
        <citizens.version>2.0.43-SNAPSHOT</citizens.version>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>luckperms</id>
            <url>https://repo.lucko.me/</url>
        </repository>
        <repository>
            <id>placeholderapi</id>
            <url>https://repo.extendedclip.com/releases/</url>
        </repository>
        <repository>
            <id>opencollab-snapshots</id>
            <url>https://repo.opencollab.dev/main/</url>
        </repository>
        <!--
          Citizens only. FancyNPCs needs no repository because it is reached by reflection — see the
          dependency block below.
        -->
        <repository>
            <id>citizens</id>
            <url>https://repo.citizensnpcs.co/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>${paper.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Soft dependency: the plugin runs without LuckPerms, only permission sync is disabled. -->
        <dependency>
            <groupId>net.luckperms</groupId>
            <artifactId>api</artifactId>
            <version>${luckperms.version}</version>
            <scope>provided</scope>
        </dependency>

        <!--
          Soft dependency, and provided rather than shaded: PlaceholderAPI must be the server's own
          instance for an expansion registered against it to be the one other plugins resolve
          through. Absent at runtime, the expansion is simply never registered — see
          RobticPlaceholders.
        -->
        <dependency>
            <groupId>me.clip</groupId>
            <artifactId>placeholderapi</artifactId>
            <version>${placeholderapi.version}</version>
            <scope>provided</scope>
        </dependency>

        <!--
          NPC backends. Both optional at runtime, both compile-only here.

          Citizens ships its API separately from the plugin, which is what `citizensapi` is. Its
          transitive dependencies are excluded because the API jar pulls in a great deal that only
          the running plugin needs, and none of it belongs on this compile path.
        -->
        <dependency>
            <groupId>net.citizensnpcs</groupId>
            <artifactId>citizensapi</artifactId>
            <version>${citizens.version}</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!--
          FancyNPCs is supported too, but it is NOT a dependency — see FancyNpcsProvider, which
          reaches it entirely through reflection.

          That is not the usual preference, and the reason is specific: the published FancyNpcs
          artifact contains only its own 90 API classes, while those classes' signatures reference
          de.oliver.fancylib, de.oliver.fancyanalytics and com.fancyinnovations.config — none of
          which it bundles or declares. javac cannot read FancyNpcsPlugin without them, so compiling
          against it means pinning three more artifacts by hand and re-pinning them on every
          FancyNPCs release. Reflection over a handful of methods is the smaller, steadier cost, and
          it keeps their repository off the critical path of this build entirely.
        -->

        <!--
          NOT YET DECLARED: org.geysermc.floodgate:api, for native Bedrock login forms.

          Bedrock players are already *detected* without it — see AuthPlatform, which reads the
          Floodgate UUID shape rather than calling the API — and they are routed to the chat prompt,
          which works on Bedrock. What the dependency buys is the native Cumulus form.

          To enable it, uncomment the block below. It resolves only from repo.opencollab.dev, which
          is declared above.

          <dependency>
              <groupId>org.geysermc.floodgate</groupId>
              <artifactId>api</artifactId>
              <version>${floodgate.version}</version>
              <scope>provided</scope>
          </dependency>
        -->

        <!--
          Shaded and relocated. Paper does ship Gson, but relying on a server-provided version
          couples this plugin to whatever Paper happens to bundle; relocating our own costs a few
          hundred kilobytes and removes the coupling entirely.

          There is deliberately no database driver here any more: the plugin reaches the Robtic API
          over HTTPS and nothing else. HTTP itself is java.net.http from the JDK, so it adds no
          dependency at all.
        -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>${gson.version}</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.name}-${project.version}</finalName>

        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>plugin.yml</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>plugin.yml</exclude>
                </excludes>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <relocations>
                                <!-- Relocated so a second plugin shading Gson can't clash with this one. -->
                                <relocation>
                                    <pattern>com.google.gson</pattern>
                                    <shadedPattern>org.robtic.minecraft.lib.gson</shadedPattern>
                                </relocation>
                            </relocations>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/versions/**</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>

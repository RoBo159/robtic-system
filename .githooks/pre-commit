#!/usr/bin/env bash
#
# Refuses to commit an Ansible vault that is not encrypted.
#
# ── Why this blocks rather than encrypts ─────────────────────────────────────────────────────────
# A hook *could* run `ansible-vault encrypt` for you. It would be the wrong thing to do:
#
#   - Vault ciphertext is salted, so encrypting the same content twice produces two different
#     files. A hook that re-encrypts on every commit would show the whole file as changed every
#     time, and a real change would be indistinguishable from noise in review.
#   - The file staged would then differ from the file in your working tree, which is the kind of
#     surprise that ends with someone committing the wrong thing.
#   - Encrypting needs the vault password. A hook that prompts for it on every commit gets disabled
#     within a week; one that reads it from a file in the repository defeats the point entirely.
#
# So this refuses the commit and tells you the command to run. Encryption stays an explicit act.
#
# Install (git does not share .git/hooks, so this is per-clone):
#
#   git config core.hooksPath .githooks
#
set -euo pipefail

fail=0

# Only what is actually staged, and only the vault files. A vault living anywhere other than
# group_vars is still a vault.
while IFS= read -r file; do
    [ -n "$file" ] || continue

    # The *staged* content, not the working tree's: those differ whenever something was added with
    # `git add -p`, and it is the staged bytes that would be pushed.
    if ! git show ":$file" 2>/dev/null | head -c 14 | grep -q '^\$ANSIBLE_VAULT'; then
        if [ "$fail" -eq 0 ]; then
            echo ""
            echo "  ┌─────────────────────────────────────────────────────────────────────┐"
            echo "  │  COMMIT BLOCKED — unencrypted Ansible vault                         │"
            echo "  └─────────────────────────────────────────────────────────────────────┘"
            echo ""
        fi
        echo "    $file is staged in PLAINTEXT."
        fail=1
    fi
done < <(git diff --cached --name-only --diff-filter=ACM | grep -E '(^|/)vault[^/]*\.ya?ml$' | grep -v '\.example$' || true)

if [ "$fail" -ne 0 ]; then
    cat <<'EOF'

    Encrypt it, stage it again, and re-commit:

        ansible-vault encrypt <file>
        git add <file>
        git commit

    Already committed once in plaintext? The secrets are in the history — rotate them.
    Encrypting the file afterwards does not remove the earlier version from git.

    To bypass this for a commit that genuinely is not a vault:  git commit --no-verify

EOF
    exit 1
fi

exit 0
